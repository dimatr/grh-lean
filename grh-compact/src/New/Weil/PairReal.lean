section
/-! Part of: Schrödinger and mixed models of the Weil representation; action of parabolic subgroups
(known result; see Lib.Weil.MixedModel.ZeroTermLaw).

Part of: Theta kernels of unitary dual pairs: functoriality, seesaw, growth, rapid decay (known
result; see Lib.Weil.DualPair.KernelDecay).

This file: Moduli prime to their conjugate; theta kernel of a polynomial and function modulo m.
Reduction of integral adeles modulo m, lifted functions, primitive additive character modulo m. -/

noncomputable section

open NumberField Finset RingHom MeasureTheory Ideal Quotient Function Space stdLattice

/-- A modulus: a nonzero ideal of O_E prime to its complex conjugate, that is, never divisible
by both w and w̄. -/
structure Modulus E [Field E] [NumberField E] [IsCMField E] where
  ideal : Ideal (𝓞 E)
  ne_bot : ideal ≠ ⊥
  not_le_star (w : FinPlace E) : ideal ≤ w → ¬ideal ≤ star w

variable {E : Type _} [Field E] [CMType E] [WeilData E]

namespace Modulus

section

variable {E : Type _} [Field E] [NumberField E] [IsCMField E]

/-- The residue ring O_E/𝔪 of the modulus 𝔪. -/
abbrev ResRing (𝔪 : Modulus E) := _ ⧸ 𝔪.ideal

instance (𝔪 : Modulus E) : Fintype 𝔪.ResRing :=
  @.ofFinite _ (Ideal.finiteQuotientOfFreeOfNeBot _ 𝔪.ne_bot)

/-- The set of finite places of E that divide 𝔪. -/
def places (𝔪 : Modulus E) := {w : FinPlace E | 𝔪.ideal ≤ w}

end

variable {n n' : Type} [Fintype n] [Fintype n'] {s : n → ℤˣ} {s' : n' → ℤˣ} (S : Space E n s)
  (T : Space E n' s') (𝔪 : Modulus E)

section

variable {E : Type _} [Field E] [NumberField E] [IsCMField E] (𝔪 : Modulus E)

instance :
  _root_.Finite 𝔪.places := by simpa [Ideal.dvd_iff_le] using! Ideal.finite_factors 𝔪.ne_bot

/-- A chosen ring homomorphism Ô → O_E/𝔪 extending reduction on O_E, with kernel tÔ for an
integral idele t equal to 1 off 𝔪. -/
def reduction : Ô E →+* 𝔪.ResRing := (exists_reduction_and_idele_generator 𝔪.ne_bot).choose

/-- The function on finite adelic vectors equal to Ψ(x mod 𝔪) if x is integral at the places
dividing 𝔪, read on those components, and 0 otherwise. -/
@[simps -isSimp] def liftFn {n : Type _} : ((n → 𝔪.ResRing) → ℂ) →ₗ[ℂ] (n → 𝔸f E) → ℂ := ⟨⟨fun Ψ
  x ↦ if h : ∀ i, idem 𝔪.places * x i ∈ _ then Ψ (𝔪.reduction ⟨_, h ·⟩) else 0, by aesop⟩, by aesop⟩

end

/-- The datum v ⊗ Ψ ⊗ vac on Hom(S,T): real part v, the function Ψ on matrices modulo 𝔪 named at
the places dividing 𝔪, the vacuum elsewhere. -/
def _root_.modDatum Ψ v :=
  (S.hom T).integrated v (Space.name _ (𝔪.places) (𝔪.liftFn (Ψ ∘ vecToMat)) (Space.vacElem _))

/-- The theta kernel θ^{S,T}_{a,b}[Ψ, P](g, h) = θ(ω_{a,b}(g,h)(v_P ⊗ Ψ ⊗ vac)) of a function Ψ
on matrices modulo 𝔪 and a polynomial P. -/
def _root_.modKernel a b 𝔪 Ψ P := (pairTheta S T a b (modDatum S T 𝔪 Ψ (polyVector _ P)) ⟨·, ·⟩)

section

variable {E : Type _} [Field E] [NumberField E] [IsCMField E] {n : Type _} [Fintype n]
  (𝔪 : Modulus E) (Ψ : (n → _) → ℂ) (x : ↥(Ô E))

/-- A chosen integral finite idele t, equal to 1 off 𝔪, such that tÔ is the kernel of reduction
modulo 𝔪. -/
def generator := (exists_reduction_and_idele_generator 𝔪.2).choose_spec.2.2.choose

attribute [local grind] reduction places not_le_star generator

lemma disjoint_places_star : 𝔪.places.IsConjDisjoint := by grind

/-- For a in O_E, the reduction map Ô → O_E/𝔪 sends the image of a in Ô to the class of a modulo
𝔪. -/
@[simp] lemma reduction_algebraMap a : 𝔪.reduction (algebraMap (𝓞 E) _ a) = a := by grind

lemma reduction_surjective : Surjective 𝔪.reduction := Quot.ind (⟨_, reduction_algebraMap _ ·⟩)

/-- For any a, b in O_E/𝔪 there is an idempotent e of O_E/𝔪 such that a and b both lie in the
principal ideal generated by (1 − e)a + eb. -/
lemma isValuationPair_resRing : @IsValuationPair 𝔪.ResRing _ ⊤ := 𝔪.reduction_surjective.forall₂.2
  (isValuationPair_Ohat.top _ · · |>.imp' (⟨𝔪.reduction ·.1, ⟨⟩⟩) fun _ ↦ by simp; grind)

/-- The chosen idele 𝗆 of the modulus 𝔪 is integral, has component 1 at every place not dividing
𝔪, and x in Ô reduces to 0 modulo 𝔪 if and only if 𝗆⁻¹x lies in Ô. -/
lemma generator_spec : ↑𝔪.generator ∈ Ô E ∧ (∀ w ∉ 𝔪.places, 𝔪.generator.1 w = 1) ∧
    ∀ x, 𝔪.reduction x = 0 ↔ 𝔪.generator⁻¹.1 * x ∈ Ô E := by grind

lemma valued_generator w : Valued.v (𝔪.generator.1 w) = .exp (-multiplicity w.1 𝔪.ideal) := by grind

attribute [local simp] generator_spec liftFn_apply mul_add mul_mem mem_integralBox
  add_mem_cancel_left idem_apply

/-- An integral finite adele z reduces to zero in O_E/𝔪 if and only if it lies in the ideal of Ô
generated by 𝔪. -/
lemma reduction_eq_zero_iff {z} : 𝔪.reduction z = 0 ↔ z ∈ 𝔪.ideal.map (algebraMap ..) := by grind

lemma reduction_congr {x y} (h : ∀ w ∈ 𝔪.places, x.1 w = y.1 w) : 𝔪.reduction x =
  𝔪.reduction y := by rw [← sub_eq_zero, ← map_sub, 𝔪.generator_spec.2.2,
  𝔪.generator.inv_mul_eq_iff_eq_mul (c := idem 𝔪.placesᶜ * (x - y)).2] <;> aesop

lemma reduction_idem_mul : 𝔪.reduction (⟨_, idem_mem_Ô 𝔪.places⟩ * x) = 𝔪.reduction x :=
  𝔪.reduction_congr (by aesop)

omit [Fintype n] in
lemma liftFn_one : 𝔪.liftFn 1 = boxIndicator n 𝔪.places := by aesop

lemma liftFn_single (x₀ : n → _) : 𝔪.liftFn (Pi.single (𝔪.reduction ∘ x₀) 1) =
  cosetIndicator 𝔪.places 𝔪.generator (x₀ ·) := by
  simpa [funext_iff, ← 𝔪.reduction_idem_mul (x₀ _), ← sub_mem_ker_iff, -map_sub,
    -map_mul, mul_left_comm (idem _), mul_sub] using fun _ ↦
    (⟨·, (mul_mem 𝔪.generator_spec.1).mt <| by simpa [sub_eq_neg_add] using ·⟩)

lemma apply_reduction_eq_of_algebraMap {S} [CommRing S] {f : 𝔪.ResRing →+* S} {g : _ →+* S} (h :
  ∀ a : 𝓞 E, f a = g (algebraMap _
  _ a) := by aesop) : f (𝔪.reduction x) = g x := have ⟨_, a, d⟩ := 𝔪.ideal.ne_bot_iff.1 𝔪.2
  (exists_dvd_sub_algebraMap d x).rec fun _ ⟨_, e⟩ ↦
    sub_eq_iff_comm.1 e ▸ by simp_all [← h, eq_zero_iff_mem.2]

@[simp] lemma factor_reduction {𝔫} h : factor h (reduction 𝔫 x) = 𝔪.reduction x :=
  apply_reduction_eq_of_algebraMap ..

end

attribute [local grind] reduction places not_le_star generator

attribute [local simp] generator_spec liftFn_apply mul_add mul_mem mem_integralBox
  add_mem_cancel_left idem_apply

variable {E : Type _} [Field E] [CMType E] {n : Type _} [Fintype n] (𝔪 : Modulus E)
  (Ψ : (n → _) → ℂ) (x : ↥(Ô E)) [WeilData E]

instance isSchwartzBruhat_liftFn : IsSchwartzBruhat 𝔪.places (𝔪.liftFn Ψ) := ⟨by simp [← mul_assoc,
  idem_mul_self, mem_Ô], pi_eq_sum_univ' Ψ ▸ (map_sum ..).substr (sum_induction _ _ .add (.const 0)
  (by simpa [𝔪.reduction_surjective.comp_left.forall, liftFn_single] using! fun _ ↦
  (IsSchwartzBruhat.locally_constant 𝔪.places).comp (_ * ·))),
  isSchwartzBruhat_boxIndicator (S := 𝔪.places).3.imp (by aesop)⟩

/-- The inner product, over the places dividing 𝔪, of the lifts of two functions Ψ, Ψ' on
(O_E/𝔪)^n is the mean over y ∈ (O_E/𝔪)^n of the conjugate of Ψ(y) times Ψ'(y). -/
lemma localInner_liftFn Ψ' : localInner 𝔪.places (𝔪.liftFn Ψ) (𝔪.liftFn Ψ') =
  star Ψ ⬝ᵥ Ψ' / Fintype.card (n → 𝔪.ResRing) := by
  let F := star Ψ * Ψ'
  have := (fourier_boxIndicator 0 0 (univ.sum F)
    (by simp [(AddGroup.addRight_bijective _).sum_comp])).symm.trans
    ((integral_finsetSum ⊤ fun y _ ↦ (isSchwartzBruhat_liftFn _ (F <| y + ·)).integrableOn
    continuous_one).trans (sum_eq_card_nsmul (𝔪.reduction_surjective.comp_left.forall.2 fun y ↦ by
    simpa [Pi.add_def, ← 𝔪.reduction_idem_mul (y _), ← map_add, -map_mul] using!
    setIntegral_add_mem (𝔪.liftFn F) (m := (y ·)) (by simp))))
  simp_all [localInner, F, dotProduct]

/-- The additive character r ↦ ψ_f(ȷ α ᾱ t⁻¹ r̃) of O_E/𝔪, where t is the chosen idele
generating 𝔪 and r̃ ∈ Ô lifts r. -/
def primAddChar := (exists_primitive_residue_addChar ⟨𝔪.reduction_surjective,
  𝔪.generator_spec.2.2⟩ forall_psi₀_mul_eq_one_iff).choose

/-- For x in Ô, the character ψ′ of O_E/𝔪 takes at the reduction of x the value ψ₀(𝗆⁻¹x), with 𝗆
the chosen idele of 𝔪 and ψ₀ = ψ_f(ȷαᾱ·). -/
@[simp] lemma primAddChar_reduction : 𝔪.primAddChar (𝔪.reduction x) =
  psi₀ E (𝔪.generator⁻¹ * x) := by grind [primAddChar]

/-- The additive character `Modulus.primAddChar` of O_E/𝔪 is primitive: for every nonzero a in
O_E/𝔪, the character x ↦ ψ(ax) is nontrivial. -/
lemma isPrimitive_primAddChar : 𝔪.primAddChar.IsPrimitive := by grind [primAddChar]

/-- Let S be the places dividing 𝔪, u in Ô^n, Ψ(x) = ψ′(∑ xᵢuᵢ) modulo 𝔪, ψ′ =
`Modulus.primAddChar`. Then Ψ⊗f = ϱ(αb̄)P^S f for all f, where b is the part above S of 𝗆⁻¹u, 𝗆 =
`Modulus.generator`. -/
lemma name_char_eq_translate_projOn {s} (V : Space E n s) {f} u :
  V.name 𝔪.places (𝔪.liftFn (𝔪.primAddChar <| · ⬝ᵥ 𝔪.reduction ∘ u)) f =
  V.ϱ (finVec (star (idem 𝔪.places • 𝔪.generator⁻¹.1 • (↑) ∘ u))) (V.projOn 𝔪.places f) := by
  rw [star_smul, (by aesop : star _ = idem 𝔪.places.conjClosure * star (idem 𝔪.places)), mul_smul,
    ← name_schrodingerAct_boxIndicator, IsSchwartzBruhat.schrodingerAct_star] <;> congr! <;>
    simp [disjoint_places_star, dotProduct, ← map_mul, ← map_sum, mul_sum]; ac_nf
end Modulus
end
end

section
/-! Part of: Theta kernels of unitary dual pairs: functoriality, seesaw, growth, rapid decay (known
result; see Lib.Weil.DualPair.KernelDecay).

Part of: Bargmann–Fock model of the harmonic (oscillator) representation of U(p,q) (known result;
see Lib.Weil.Fock.OscillatorPair).

This file: Real dual pair on Fock space; maximal compact subgroups act by substitution and
character. -/

noncomputable section


section

variable (E : Type) [Field E] [NumberField E] {n n' : Type} [Fintype n] [Fintype n'] (s : n → ℤˣ)
  (s' : n' → ℤˣ) (γ γ' : _ → ℤ) {x : GInf E s} {y : GInf E s'}
open Matrix Kronecker Fintype Finset Space MvPolynomial Heisenberg.IsVacuum AutChar

/-- The Fock space for the signs s′_i s_j of Hom(S,T), repeated at every infinite place. -/
abbrev PairFock := fockSpace (realSigns E (homSigns s s'))

variable {E s s'}

/-- The homomorphism sending real points (x, y) to the action z ↦ y_w z x_w⁻¹ on matrices at
each infinite place w, as one block diagonal unitary matrix. -/
def pairHomInf := blockU.comp (.pi fun w ↦ (pairHom ..).comp ((Pi.evalMonoidHom _ w).prodMap
  (Pi.evalMonoidHom _ w)) : GInf .. × GInf .. →* GInf E (homSigns s s'))

/-- The real Weil representation of the pair with weights γ, γ′: (x, y) acts by ∏_w (det
y_w)^{γ_w} (det x_w)^{−γ′_w} times the Fock operator of z ↦ y z x⁻¹. -/
@[simps! -isSimp apply_apply] def realPairWeil := (⟨⟨fun p ↦ (∏ w, (p.2 w).1.1.det ^ γ w *
  (p.1 w).1.1.det ^ (-γ' w)) • realWeil (pairHomInf p), by simp⟩, by
  simp_intro .. [mul_zpow]; module⟩ : _ →* PairFock E s s' →L[ℂ] PairFock ..)

@[fun_prop] lemma continuous_realPairWeil : Continuous fun q : _ × PairFock E s s' ↦
  realPairWeil γ γ' q.1 q.2 := by
  have : Continuous (@pairHomInf E _ _ _ _ _ _ s
    s') := by simp [continuous_U_iff_matrix, pairHomInf]; fun_prop [kroneckerMap]
  simp [-prod_mul_distrib, realPairWeil]; fun_prop (disch := simp)

attribute [simp] principalMinor_of_forall principalMinor_of_forall_not

lemma det_eq_prod_principalMinor {u : USign s} (h : ↑u ∈ blockDiagAlg s) : u.1.1.det = ∏ σ,
  principalMinor u (s · = σ) := by
  simpa using! BlockTriangular.det_fintype (mem_blockDiagAlg.1 h · · ·.ne')

/-- For x, y block diagonal for signs s, s′ of signatures (p,q), (p′,q′): Ω(x,y)v_P = ∏_w (det
y⁺)^{γ−q}(det y⁻)^{γ−p}(det x⁺)^{q′−γ′}(det x⁻)^{p′−γ′} v_Q, Q from P by X_{ab} ↦ ∑
y_{ia}(x⁻¹)_{bj}X_{ij} if s′_a = s_b, else ∑ (y⁻¹)_{ai}x_{jb}X_{ij}. -/
lemma realPairWeil_polyVector (hx : ∀ w, ↑(x w) ∈ blockDiagAlg s) (hy : ∀ w,
  ↑(y w) ∈ blockDiagAlg s') P : realPairWeil γ γ' (x, y) (polyVector _ P) =
  (∏ w, ∏ σ ∈ {1, -1}, principalMinor (y w) (s' · = σ) ^ (γ w - Nat.card {i //
  s i = -σ}) * principalMinor (x w) (s · = σ) ^ (Nat.card {i // s' i = -σ} - γ' w)) •
  polyVector _ (aeval (fun c ↦ ∑ i, ∑ j, ite (s' c.2.1 = s c.2.2) ((y c.1).1.1 i c.2.1 *
  (x c.1)⁻¹.1.1 c.2.2 j) ((y c.1)⁻¹.1.1 c.2.1 i * (x c.1).1.1 j c.2.2) • X (c.1, i, j)) P) := by
  have e := maxCompactU.coe_inv ⟨pairHomInf (x, y), ?_⟩
  erw [_root_.smul_apply, weilRep_eq_integral, ← integrated_vacElem (polyVector _ (aeval _ P)),
    smul_smul, congr(_ * $(realMultiplier_blockU _)), ← prod_mul_distrib]
  congrm (∏ w, ?_) • ∫ _, ?_ • _ ∂_
  rw [realMultiplier, ← U.principalMinor_coe_inv,
    ← div_eq_of_eq_mul _ (principalMinor_mul (b := y w ⊗ₖ 1) _)]
  pick_goal 4
  simp [realVac, star_mulVec_dotProduct, *]
  simp [← e]; convert! (eval₂Hom_bind₁ ..).symm
  nth_rw 1 [holCoord_eq, e]; norm_cast
  repeat simp [← map_inv, principalMinor_kronecker_one, one_kronecker, pairHom, blockDiagonal_apply,
    sum_prod_type, holCoord_eq, ← fun w ↦ prod_fiberwise' s fun c ↦
    principalMinor (y w) (s' · * c = -1), mul_zpow, zpow_sub₀, pairHomInf, pairSign, ← fun w ↦
    prod_fiberwise' s' fun c ↦ principalMinor (x w) (c * s · = -1), det_eq_prod_principalMinor, *,
    entrywise, mem_blockDiagAlg, mem_maxCompactU, mul_eq_one_iff_eq_inv,
    apply_ite] <;> (try split) <;> grind [mul_eq_zero, mem_blockDiagAlg, → blockDiagAlg.inv_mem]

end

open Matrix Kronecker Fintype Finset Space MvPolynomial Heisenberg.IsVacuum AutChar

variable {E : Type} [Field E] [CMType E] {n n' : Type} [Fintype n] [Fintype n'] {s : n → ℤˣ}
  {s' : n' → ℤˣ} {γ γ' : _ → ℤ} {x : GInf E s} {y : GInf E s'} [WeilData E] (S : Space E n s)
  (T : Space E n' s') (a b : AutChar E) {ψ : (w : FinPlace E) → MulChar (ResField w) ℂ}
  {ψ' : (w : FinPlace E) → MulChar (ResField w) ℂ}

/-- The theta kernel of the pair S, T with characters a, b: the representation ω_{a,b} on
𝒮(Hom(S,T)) and the theta functional of Hom(S,T), as a `ThetaKernel`. -/
@[simps] abbrev pairThetaKer : ThetaKernel (𝒮 (S.hom T)) S T :=
  ⟨pairWeil S T a b, θ _, by fun_prop, by simp_all [← Prod.mk_mul_mk, pairWeil_of_mem_Gamma]⟩

attribute [local simp] pairWeil omega_integrated G.onHom_eq realPairWeil HasWeight.apply_eq
  pairHomInf MonoidHom.pi

/-- If a has weight γ and b has weight γ' (with tame parts ψ, ψ'), then for real points x, y,
ω_{a,b}(x,y)(v⊗f) = (Ω(x,y)v)⊗f, where Ω is the real Weil representation of the pair for the
weights γ, γ'. -/
lemma pairWeil_integrated [HasWeight a γ ψ] [HasWeight b γ' ψ'] x y v f :
  pairWeil S T a b ((x, 1), y, 1) (integrated _ v f) =
  integrated _ (realPairWeil γ γ' (x, y) v) f := by simp [← Submonoid.one_def]

@[simp] lemma pairWeil_integrated_fin k k' v f : pairWeil S T a b ((1, k), 1, k') (integrated _ v
  f) = integrated _ v (pairWeil S T a b ((1, k), 1, k') f) := by simp [← Pi.one_def]

variable {S T}

lemma pairWeil_integrated_right {f} [ha : HasWeight a γ ψ] h v : pairWeil S T a b (1, h, 1)
  (integrated _ v f) = integrated _ (realPairWeil γ 0 (1, h) v) f := by simp [← Submonoid.one_def]

lemma pairWeil_integrated_all {a b} [HasWeight a γ ψ] [HasWeight b γ' ψ'] x k y k' v f :
  pairWeil S T a b ((x, k), y, k')
  (integrated _ v f) = integrated _ (realPairWeil γ γ' (x, y) v) (pairWeil S T a b (k, k') f) := by
  rw [← pairWeil_integrated_fin, ← pairWeil_integrated S T a b, rep_apply_apply]; simp
end
end
